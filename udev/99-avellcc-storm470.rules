# Avell Storm 470 (Uniwill/TongFang barebone) — ITE HID controllers
# Grants non-root access to the per-key RGB keyboard controller.
#
# GROUP="input" is what actually grants access here: it works for system
# services and non-seat sessions, where the uaccess ACL is not applied.
# TAG+="uaccess" is kept so a logged-in seat user also gets an ACL.

# ITE 8291 (rev 3 family) — keyboard RGB LED controller
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="048d", ATTRS{idProduct}=="600b", GROUP="input", MODE="0660", TAG+="uaccess"

# ITE 8233 — chassis light bar (see docs/storm470-lightbar.md)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="048d", ATTRS{idProduct}=="7001", GROUP="input", MODE="0660", TAG+="uaccess"

# FindITE8233 probes all three product ids tuxedo-drivers lists for this
# protocol, so the rule covers all three. Only 7001 is present on this machine;
# the other two are here so the fork works on a sibling barebone without a
# second round of sudo.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="048d", ATTRS{idProduct}=="7000", GROUP="input", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="048d", ATTRS{idProduct}=="6010", GROUP="input", MODE="0660", TAG+="uaccess"
